# MongoDB Proxy — required environment (this repo is PUBLIC; never commit real values)
# The connection string for the Saica Mongo (user + password).
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/?authSource=admin
# Bearer token every caller must present. MUST equal the qcw-script-host Worker
# secret INGEST_UPSTREAM_TOKEN. >= 16 chars; the server refuses to start without it.
PROXY_AUTH_TOKEN=
# Optional
DATABASE=Saica
PORT=3000
